# ==========================================
# Vehicle Log App - Environment Template
# ==========================================
# NOTE: DO NOT put real secrets in this file.
# Copy this file to .env and fill in your actual values.

# Application Configuration
APP_NAME="Vehicle Usage Log App"
APP_ENV=development
APP_PORT=3000

# Security & Data Encryption Key (Local Storage fallback encryption)
APP_SECRET_KEY=your_secret_key_here

# Firebase / Backend API Configuration (Optional)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_MAP_API_KEY=your_google_maps_api_key_here
